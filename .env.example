DATABASE_URL=
TWITTERAPI_IO_API_KEY=
# Optional, only needed by `npm run verify:account` for one-account count comparisons.
X_BEARER_TOKEN=
# Seeds and scans the 30 most recent followings per account by default. Lower or raise to cap read volume.
TWITTERAPI_IO_MAX_RESULTS_PER_ACCOUNT=
CRON_SECRET=
# AI Gateway uses VERCEL_OIDC_TOKEN, provisioned by `vercel link` + `vercel env pull`.
# Use AI_GATEWAY_API_KEY only if running outside a linked Vercel environment.
